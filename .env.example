# Copy to .env and adjust. `make run` loads .env when it exists.
# Lines are KEY=VALUE with no quotes.

# Root of the data tree shared with pred-engine (raw/, processed/, logs/).
# Relative paths resolve against the directory the server starts from.
PRED_DATA_ROOT=data

# SQLite file behind the DAL. Defaults to <PRED_DATA_ROOT>/pred.db when blank.
PRED_DB_PATH=
