# Copy to .env and adjust. `make run` loads .env when it exists.
# Lines are KEY=VALUE with no quotes.

# Root of the data tree shared with pred-engine (raw/, processed/, logs/).
# Relative paths resolve against the directory the server starts from.
PRED_DATA_ROOT=data

# SQLite file behind the DAL. Defaults to <PRED_DATA_ROOT>/pred.db when blank.
PRED_DB_PATH=

# Where the views read from.
#   dal      the platform's SQLite database (the real data). Default when blank.
#   fixture  the data contract's sample documents, to build screens before the engine's results
#            reach the database. Documents then carry source="fixture".
PRED_DATA_SOURCE=fixture

# Which sample data `fixture` serves: normal (happy path), vacio (empty/unavailable states) or
# errores (failed uploads, failed tasks). Ignored when PRED_DATA_SOURCE is dal.
PRED_FIXTURE_SCENARIO=normal
