{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pred-contrato/v2/m3_run_status.schema.json",
  "x-contract-version": "2.0.0",
  "$defs": {
    "Availability": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "available",
            "unavailable"
          ],
          "title": "Status",
          "type": "string"
        },
        "reason_code": {
          "anyOf": [
            {
              "enum": [
                "no_data",
                "not_published",
                "metadata_missing"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reason Code"
        },
        "detail": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Detail"
        }
      },
      "required": [
        "status",
        "reason_code",
        "detail"
      ],
      "title": "Availability",
      "type": "object"
    },
    "M3Progress": {
      "additionalProperties": false,
      "properties": {
        "run_id": {
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "ingesta_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Ingesta Sha256",
          "type": "string"
        },
        "sku": {
          "title": "Sku",
          "type": "null"
        },
        "n_unidades_previstas": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "N Unidades Previstas"
        },
        "n_resueltas": {
          "minimum": 0,
          "title": "N Resueltas",
          "type": "integer"
        },
        "n_confirmadas": {
          "minimum": 0,
          "title": "N Confirmadas",
          "type": "integer"
        },
        "n_fallidas": {
          "minimum": 0,
          "title": "N Fallidas",
          "type": "integer"
        }
      },
      "required": [
        "run_id",
        "ingesta_sha256",
        "sku",
        "n_unidades_previstas",
        "n_resueltas",
        "n_confirmadas",
        "n_fallidas"
      ],
      "title": "M3Progress",
      "type": "object"
    },
    "M3Run": {
      "additionalProperties": false,
      "properties": {
        "datos_sinteticos": {
          "title": "Datos Sinteticos",
          "type": "boolean"
        },
        "origen_declarado": {
          "title": "Origen Declarado",
          "type": "boolean"
        },
        "run_id": {
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "ingesta_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Ingesta Sha256",
          "type": "string"
        },
        "sku": {
          "title": "Sku",
          "type": "null"
        },
        "run_id_m2": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Run Id M2"
        },
        "identidad": {
          "minLength": 1,
          "title": "Identidad",
          "type": "string"
        },
        "estado": {
          "enum": [
            "EN_CURSO",
            "EVALUADA",
            "SELECCIONADA",
            "PUBLICADA",
            "RECHAZADA"
          ],
          "title": "Estado",
          "type": "string"
        },
        "causa_rechazo": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Causa Rechazo"
        },
        "creado_en": {
          "format": "date-time",
          "title": "Creado En",
          "type": "string"
        },
        "policy": {
          "anyOf": [
            {
              "$ref": "#/$defs/SelectionPolicy"
            },
            {
              "type": "null"
            }
          ]
        },
        "publicadas_misma_identidad": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Publicadas Misma Identidad",
          "type": "array"
        },
        "aviso": {
          "anyOf": [
            {
              "const": "varias_publicadas_misma_identidad",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Aviso"
        }
      },
      "required": [
        "datos_sinteticos",
        "origen_declarado",
        "run_id",
        "ingesta_sha256",
        "sku",
        "run_id_m2",
        "identidad",
        "estado",
        "causa_rechazo",
        "creado_en",
        "policy",
        "publicadas_misma_identidad",
        "aviso"
      ],
      "title": "M3Run",
      "type": "object"
    },
    "SelectionPolicy": {
      "additionalProperties": false,
      "description": "Proyeccion de m3_protocolos.protocolo.politica; no son ajustes de la vista.",
      "properties": {
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        },
        "n_min": {
          "minimum": 1,
          "title": "N Min",
          "type": "integer"
        },
        "n_min_dm": {
          "minimum": 2,
          "title": "N Min Dm",
          "type": "integer"
        },
        "alfa_dm": {
          "exclusiveMaximum": 1,
          "exclusiveMinimum": 0,
          "title": "Alfa Dm",
          "type": "number"
        }
      },
      "required": [
        "version",
        "n_min",
        "n_min_dm",
        "alfa_dm"
      ],
      "title": "SelectionPolicy",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "pattern": "^2\\.[0-9]+\\.[0-9]+$",
      "title": "Schema Version",
      "type": "string"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "source": {
      "enum": [
        "dal",
        "fixture"
      ],
      "title": "Source",
      "type": "string"
    },
    "availability": {
      "$ref": "#/$defs/Availability"
    },
    "run": {
      "anyOf": [
        {
          "$ref": "#/$defs/M3Run"
        },
        {
          "type": "null"
        }
      ]
    },
    "progress": {
      "anyOf": [
        {
          "$ref": "#/$defs/M3Progress"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "generated_at",
    "source",
    "availability",
    "run",
    "progress"
  ],
  "title": "M3RunStatus",
  "type": "object"
}
