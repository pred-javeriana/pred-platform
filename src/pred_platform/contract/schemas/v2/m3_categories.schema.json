{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pred-contrato/v2/m3_categories.schema.json",
  "x-contract-version": "2.0.0",
  "$defs": {
    "Availability": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "available",
            "unavailable"
          ],
          "title": "Status",
          "type": "string"
        },
        "reason_code": {
          "anyOf": [
            {
              "enum": [
                "no_data",
                "not_published",
                "metadata_missing"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reason Code"
        },
        "detail": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Detail"
        }
      },
      "required": [
        "status",
        "reason_code",
        "detail"
      ],
      "title": "Availability",
      "type": "object"
    },
    "ConteosVeredicto": {
      "additionalProperties": false,
      "properties": {
        "FALLO_TECNICO": {
          "minimum": 0,
          "title": "Fallo Tecnico",
          "type": "integer"
        },
        "NO_EVALUABLE": {
          "minimum": 0,
          "title": "No Evaluable",
          "type": "integer"
        },
        "EVIDENCIA_INSUFICIENTE": {
          "minimum": 0,
          "title": "Evidencia Insuficiente",
          "type": "integer"
        },
        "VALIDADO": {
          "minimum": 0,
          "title": "Validado",
          "type": "integer"
        },
        "EXPLORATORIO": {
          "minimum": 0,
          "title": "Exploratorio",
          "type": "integer"
        }
      },
      "required": [
        "FALLO_TECNICO",
        "NO_EVALUABLE",
        "EVIDENCIA_INSUFICIENTE",
        "VALIDADO",
        "EXPLORATORIO"
      ],
      "title": "ConteosVeredicto",
      "type": "object"
    },
    "M3Category": {
      "additionalProperties": false,
      "properties": {
        "run_id": {
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "ingesta_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Ingesta Sha256",
          "type": "string"
        },
        "sku": {
          "title": "Sku",
          "type": "null"
        },
        "sku_class": {
          "enum": [
            "smooth",
            "intermittent",
            "erratic",
            "lumpy"
          ],
          "title": "Sku Class",
          "type": "string"
        },
        "familia_campeona": {
          "enum": [
            "classical",
            "ml",
            "dl",
            "foundation",
            "seasonal_naive"
          ],
          "title": "Familia Campeona",
          "type": "string"
        },
        "motivo": {
          "enum": [
            "menor_mediana",
            "empate_por_simplicidad",
            "compuerta_linea_base",
            "sin_skus_comparables"
          ],
          "title": "Motivo",
          "type": "string"
        },
        "adverso": {
          "title": "Adverso",
          "type": "boolean"
        },
        "medianas_r": {
          "additionalProperties": {
            "minimum": 0,
            "type": "number"
          },
          "propertyNames": {
            "enum": [
              "classical",
              "ml",
              "dl",
              "foundation",
              "seasonal_naive"
            ]
          },
          "title": "Medianas R",
          "type": "object"
        },
        "skus_comparables": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Skus Comparables",
          "type": "array"
        },
        "excluidos": {
          "additionalProperties": {
            "minLength": 1,
            "type": "string"
          },
          "propertyNames": {
            "minLength": 1
          },
          "title": "Excluidos",
          "type": "object"
        },
        "familias_excluidas": {
          "additionalProperties": {
            "enum": [
              "no_entregada",
              "no_elegible"
            ],
            "type": "string"
          },
          "propertyNames": {
            "enum": [
              "classical",
              "ml",
              "dl",
              "foundation",
              "seasonal_naive"
            ]
          },
          "title": "Familias Excluidas",
          "type": "object"
        },
        "conteos": {
          "$ref": "#/$defs/ConteosVeredicto"
        },
        "porcentajes": {
          "$ref": "#/$defs/PorcentajesVeredicto"
        },
        "mediana_r": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Mediana R"
        },
        "n_adversos": {
          "minimum": 0,
          "title": "N Adversos",
          "type": "integer"
        }
      },
      "required": [
        "run_id",
        "ingesta_sha256",
        "sku",
        "sku_class",
        "familia_campeona",
        "motivo",
        "adverso",
        "medianas_r",
        "skus_comparables",
        "excluidos",
        "familias_excluidas",
        "conteos",
        "porcentajes",
        "mediana_r",
        "n_adversos"
      ],
      "title": "M3Category",
      "type": "object"
    },
    "M3Run": {
      "additionalProperties": false,
      "properties": {
        "datos_sinteticos": {
          "title": "Datos Sinteticos",
          "type": "boolean"
        },
        "origen_declarado": {
          "title": "Origen Declarado",
          "type": "boolean"
        },
        "run_id": {
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "ingesta_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Ingesta Sha256",
          "type": "string"
        },
        "sku": {
          "title": "Sku",
          "type": "null"
        },
        "run_id_m2": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Run Id M2"
        },
        "identidad": {
          "minLength": 1,
          "title": "Identidad",
          "type": "string"
        },
        "estado": {
          "enum": [
            "EN_CURSO",
            "EVALUADA",
            "SELECCIONADA",
            "PUBLICADA",
            "RECHAZADA"
          ],
          "title": "Estado",
          "type": "string"
        },
        "causa_rechazo": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Causa Rechazo"
        },
        "creado_en": {
          "format": "date-time",
          "title": "Creado En",
          "type": "string"
        },
        "policy": {
          "anyOf": [
            {
              "$ref": "#/$defs/SelectionPolicy"
            },
            {
              "type": "null"
            }
          ]
        },
        "publicadas_misma_identidad": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Publicadas Misma Identidad",
          "type": "array"
        },
        "aviso": {
          "anyOf": [
            {
              "const": "varias_publicadas_misma_identidad",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Aviso"
        }
      },
      "required": [
        "datos_sinteticos",
        "origen_declarado",
        "run_id",
        "ingesta_sha256",
        "sku",
        "run_id_m2",
        "identidad",
        "estado",
        "causa_rechazo",
        "creado_en",
        "policy",
        "publicadas_misma_identidad",
        "aviso"
      ],
      "title": "M3Run",
      "type": "object"
    },
    "Page": {
      "additionalProperties": false,
      "properties": {
        "number": {
          "minimum": 1,
          "title": "Number",
          "type": "integer"
        },
        "size": {
          "maximum": 500,
          "minimum": 1,
          "title": "Size",
          "type": "integer"
        },
        "total": {
          "minimum": 0,
          "title": "Total",
          "type": "integer"
        }
      },
      "required": [
        "number",
        "size",
        "total"
      ],
      "title": "Page",
      "type": "object"
    },
    "PorcentajesVeredicto": {
      "additionalProperties": false,
      "properties": {
        "FALLO_TECNICO": {
          "maximum": 100,
          "minimum": 0,
          "title": "Fallo Tecnico",
          "type": "number"
        },
        "NO_EVALUABLE": {
          "maximum": 100,
          "minimum": 0,
          "title": "No Evaluable",
          "type": "number"
        },
        "EVIDENCIA_INSUFICIENTE": {
          "maximum": 100,
          "minimum": 0,
          "title": "Evidencia Insuficiente",
          "type": "number"
        },
        "VALIDADO": {
          "maximum": 100,
          "minimum": 0,
          "title": "Validado",
          "type": "number"
        },
        "EXPLORATORIO": {
          "maximum": 100,
          "minimum": 0,
          "title": "Exploratorio",
          "type": "number"
        }
      },
      "required": [
        "FALLO_TECNICO",
        "NO_EVALUABLE",
        "EVIDENCIA_INSUFICIENTE",
        "VALIDADO",
        "EXPLORATORIO"
      ],
      "title": "PorcentajesVeredicto",
      "type": "object"
    },
    "SelectionPolicy": {
      "additionalProperties": false,
      "description": "Proyeccion de m3_protocolos.protocolo.politica; no son ajustes de la vista.",
      "properties": {
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        },
        "n_min": {
          "minimum": 1,
          "title": "N Min",
          "type": "integer"
        },
        "n_min_dm": {
          "minimum": 2,
          "title": "N Min Dm",
          "type": "integer"
        },
        "alfa_dm": {
          "exclusiveMaximum": 1,
          "exclusiveMinimum": 0,
          "title": "Alfa Dm",
          "type": "number"
        }
      },
      "required": [
        "version",
        "n_min",
        "n_min_dm",
        "alfa_dm"
      ],
      "title": "SelectionPolicy",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "pattern": "^2\\.[0-9]+\\.[0-9]+$",
      "title": "Schema Version",
      "type": "string"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "source": {
      "enum": [
        "dal",
        "fixture"
      ],
      "title": "Source",
      "type": "string"
    },
    "availability": {
      "$ref": "#/$defs/Availability"
    },
    "run": {
      "anyOf": [
        {
          "$ref": "#/$defs/M3Run"
        },
        {
          "type": "null"
        }
      ]
    },
    "items": {
      "items": {
        "$ref": "#/$defs/M3Category"
      },
      "title": "Items",
      "type": "array"
    },
    "page": {
      "$ref": "#/$defs/Page"
    }
  },
  "required": [
    "schema_version",
    "generated_at",
    "source",
    "availability",
    "run",
    "items",
    "page"
  ],
  "title": "M3Categories",
  "type": "object"
}
