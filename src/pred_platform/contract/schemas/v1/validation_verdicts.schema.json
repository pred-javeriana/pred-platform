{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pred-contrato/v1/validation_verdicts.schema.json",
  "$defs": {
    "Availability": {
      "additionalProperties": false,
      "description": "Si el dato existe hoy. Sostiene estados vacios y acciones deshabilitadas.",
      "properties": {
        "status": {
          "enum": [
            "available",
            "unavailable"
          ],
          "title": "Status",
          "type": "string"
        },
        "reason_code": {
          "anyOf": [
            {
              "enum": [
                "no_data",
                "not_implemented",
                "stage_not_implemented",
                "prerequisite_missing"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason Code"
        },
        "blocked_by": {
          "items": {
            "pattern": "^G[1-8]$",
            "type": "string"
          },
          "title": "Blocked By",
          "type": "array"
        },
        "detail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detail"
        }
      },
      "required": [
        "status"
      ],
      "title": "Availability",
      "type": "object"
    },
    "JsonValue": {},
    "SkuVerdict": {
      "additionalProperties": false,
      "description": "Fila de `reportes_validacion`.",
      "properties": {
        "sku_id": {
          "title": "Sku Id",
          "type": "string"
        },
        "modelo_campeon": {
          "pattern": "^(classical|ml|dl|foundation):[a-z0-9][a-z0-9._-]*$",
          "title": "Modelo Campeon",
          "type": "string"
        },
        "veredicto": {
          "enum": [
            "mantiene",
            "parcial",
            "falla"
          ],
          "title": "Veredicto",
          "type": "string"
        },
        "detalle": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Detalle",
          "type": "object"
        }
      },
      "required": [
        "sku_id",
        "modelo_campeon",
        "veredicto"
      ],
      "title": "SkuVerdict",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "pattern": "^1\\.[0-9]+\\.[0-9]+$",
      "title": "Schema Version",
      "type": "string"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "source": {
      "enum": [
        "dal",
        "fixture"
      ],
      "title": "Source",
      "type": "string"
    },
    "availability": {
      "$ref": "#/$defs/Availability"
    },
    "run_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Run Id"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/SkuVerdict"
      },
      "title": "Items",
      "type": "array"
    },
    "audit_bundle": {
      "anyOf": [
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Audit Bundle"
    }
  },
  "required": [
    "schema_version",
    "generated_at",
    "source",
    "availability",
    "items"
  ],
  "title": "ValidationVerdicts",
  "type": "object",
  "x-contract-version": "1.0.0"
}
