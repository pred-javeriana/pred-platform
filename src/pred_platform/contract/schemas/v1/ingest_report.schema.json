{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pred-contrato/v1/ingest_report.schema.json",
  "x-contract-version": "1.3.0",
  "$defs": {
    "Availability": {
      "additionalProperties": false,
      "description": "Si el dato existe hoy. Sostiene estados vacios y acciones deshabilitadas.",
      "properties": {
        "status": {
          "enum": [
            "available",
            "unavailable"
          ],
          "title": "Status",
          "type": "string"
        },
        "reason_code": {
          "anyOf": [
            {
              "enum": [
                "no_data",
                "not_implemented",
                "stage_not_implemented",
                "prerequisite_missing"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason Code"
        },
        "blocked_by": {
          "items": {
            "pattern": "^G[1-8]$",
            "type": "string"
          },
          "title": "Blocked By",
          "type": "array"
        },
        "detail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detail"
        }
      },
      "required": [
        "status"
      ],
      "title": "Availability",
      "type": "object"
    },
    "Deposit": {
      "additionalProperties": false,
      "properties": {
        "raw_path": {
          "title": "Raw Path",
          "type": "string"
        },
        "status": {
          "enum": [
            "deposited",
            "already_present_identical",
            "already_present_different"
          ],
          "title": "Status",
          "type": "string"
        },
        "would_overwrite": {
          "title": "Would Overwrite",
          "type": "boolean"
        }
      },
      "required": [
        "raw_path",
        "status",
        "would_overwrite"
      ],
      "title": "Deposit",
      "type": "object"
    },
    "DiagnosticEntry": {
      "additionalProperties": false,
      "properties": {
        "field": {
          "title": "Field",
          "type": "string"
        },
        "severity": {
          "default": "error",
          "enum": [
            "info",
            "advertencia",
            "error"
          ],
          "title": "Severity",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "action": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Action"
        }
      },
      "required": [
        "field",
        "message"
      ],
      "title": "DiagnosticEntry",
      "type": "object"
    },
    "DiscardCause": {
      "additionalProperties": false,
      "description": "Cuantos ensayos se descartaron por una causa del motor y un ejemplo.\n\n`cause` es un identificador abierto del motor (`ajuste_fallido`, `escalon`,\n`poda_semantica`, `configuracion_invalida`, `ninguna_ventana_convergio`,\n`sin_motivo_registrado`).",
      "properties": {
        "cause": {
          "minLength": 1,
          "title": "Cause",
          "type": "string"
        },
        "count": {
          "minimum": 1,
          "title": "Count",
          "type": "integer"
        },
        "example": {
          "anyOf": [
            {
              "$ref": "#/$defs/DiscardExample"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "cause",
        "count"
      ],
      "title": "DiscardCause",
      "type": "object"
    },
    "DiscardExample": {
      "additionalProperties": false,
      "description": "Un ensayo de la busqueda descartado por una causa, como ejemplo de esa causa.\n\n`window` es la ventana de validacion (desde 1) en que se descarto. Una poda por escalon\nlleva `rung`, el error del ensayo en `value` y el umbral de los `keep` mejores en\n`threshold`; una poda semantica, la regla en `rule` y el error en `value`; una\nconfiguracion invalida, la restriccion que no cumplio en `constraint`; un ajuste\nfallido, `fit`.",
      "properties": {
        "window": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Window"
        },
        "rung": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rung"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "threshold": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Threshold"
        },
        "keep": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Keep"
        },
        "rule": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rule"
        },
        "constraint": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Constraint"
        },
        "fit": {
          "anyOf": [
            {
              "$ref": "#/$defs/FitFacts"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "DiscardExample",
      "type": "object"
    },
    "ErrorFacts": {
      "additionalProperties": false,
      "description": "Datos estructurados de un error del motor (desde 1.3.0, seccion 11).\n\nRepiten en campos lo que `detail` cuenta en texto, para que la interfaz los muestre sin\nleer el mensaje. Cada grupo es opcional: el motor solo envia los que conoce.",
      "properties": {
        "search": {
          "anyOf": [
            {
              "$ref": "#/$defs/SearchFacts"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "fit": {
          "anyOf": [
            {
              "$ref": "#/$defs/FitFacts"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "history": {
          "anyOf": [
            {
              "$ref": "#/$defs/HistoryFacts"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "ErrorFacts",
      "type": "object"
    },
    "ErrorInfo": {
      "additionalProperties": false,
      "description": "Error normalizado. `code` es el que se persiste en `bitacora_calidad.codigo`.",
      "properties": {
        "code": {
          "anyOf": [
            {
              "enum": [
                "not_in_policy_matrix",
                "not_configured",
                "series_too_short",
                "execution_failed"
              ],
              "type": "string"
            },
            {
              "pattern": "^[a-z_]+\\.[a-z_]+$",
              "type": "string"
            }
          ],
          "title": "Code"
        },
        "stage": {
          "enum": [
            "L0",
            "L1",
            "L2",
            "L3",
            "L4",
            "platform"
          ],
          "title": "Stage",
          "type": "string"
        },
        "severity": {
          "default": "error",
          "enum": [
            "info",
            "advertencia",
            "error"
          ],
          "title": "Severity",
          "type": "string"
        },
        "detail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detail"
        },
        "field": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Field"
        },
        "row_index": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Row Index"
        },
        "column": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Column"
        },
        "source_exception": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Exception"
        },
        "retryable": {
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        },
        "facts": {
          "anyOf": [
            {
              "$ref": "#/$defs/ErrorFacts"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "code",
        "stage"
      ],
      "title": "ErrorInfo",
      "type": "object"
    },
    "FitFacts": {
      "additionalProperties": false,
      "description": "Por que un modelo no se ajusto o no pronostico (desde 1.3.0, seccion 11).\n\n`reason` es un identificador abierto del motor (`raiz_en_borde`, `sin_convergencia`,\n`error_biblioteca`, `pronostico_fallido`, `forma_cuantiles`, `cuantil_ausente`). `value`\ny `limit` son el valor medido y el limite que no cumplio, cuando la causa es numerica.",
      "properties": {
        "model": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "limit": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Limit"
        }
      },
      "required": [
        "reason"
      ],
      "title": "FitFacts",
      "type": "object"
    },
    "HeaderDiagnostic": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "accepted",
            "rejected"
          ],
          "title": "Status",
          "type": "string"
        },
        "entries": {
          "items": {
            "$ref": "#/$defs/DiagnosticEntry"
          },
          "title": "Entries",
          "type": "array"
        }
      },
      "required": [
        "status"
      ],
      "title": "HeaderDiagnostic",
      "type": "object"
    },
    "HistoryFacts": {
      "additionalProperties": false,
      "description": "Observaciones que exigia el modelo o la validacion y las que tenia la serie.",
      "properties": {
        "required": {
          "minimum": 1,
          "title": "Required",
          "type": "integer"
        },
        "available": {
          "minimum": 0,
          "title": "Available",
          "type": "integer"
        }
      },
      "required": [
        "required",
        "available"
      ],
      "title": "HistoryFacts",
      "type": "object"
    },
    "PublishedArtifact": {
      "additionalProperties": false,
      "properties": {
        "parquet_path": {
          "title": "Parquet Path",
          "type": "string"
        },
        "rows": {
          "minimum": 0,
          "title": "Rows",
          "type": "integer"
        },
        "n_skus": {
          "minimum": 0,
          "title": "N Skus",
          "type": "integer"
        },
        "columns": {
          "items": {
            "type": "string"
          },
          "title": "Columns",
          "type": "array"
        }
      },
      "required": [
        "parquet_path",
        "rows",
        "n_skus",
        "columns"
      ],
      "title": "PublishedArtifact",
      "type": "object"
    },
    "QualityEntry": {
      "additionalProperties": false,
      "description": "Espejo de una fila de `bitacora_calidad`.",
      "properties": {
        "severity": {
          "enum": [
            "info",
            "advertencia",
            "error"
          ],
          "title": "Severity",
          "type": "string"
        },
        "code": {
          "pattern": "^[a-z_]+\\.[a-z_]+$",
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "row_index": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Row Index"
        },
        "column": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Column"
        }
      },
      "required": [
        "severity",
        "code",
        "message"
      ],
      "title": "QualityEntry",
      "type": "object"
    },
    "SearchFacts": {
      "additionalProperties": false,
      "description": "Resumen de una busqueda de configuraciones que no dejo ningun ensayo completo.",
      "properties": {
        "failed": {
          "minimum": 0,
          "title": "Failed",
          "type": "integer"
        },
        "pruned": {
          "minimum": 0,
          "title": "Pruned",
          "type": "integer"
        },
        "invalid_attempts": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Invalid Attempts"
        },
        "causes": {
          "items": {
            "$ref": "#/$defs/DiscardCause"
          },
          "title": "Causes",
          "type": "array"
        }
      },
      "required": [
        "failed",
        "pruned"
      ],
      "title": "SearchFacts",
      "type": "object"
    },
    "SourceFile": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "row_count": {
          "minimum": 0,
          "title": "Row Count",
          "type": "integer"
        }
      },
      "required": [
        "name",
        "sha256",
        "row_count"
      ],
      "title": "SourceFile",
      "type": "object"
    },
    "ValidationSummary": {
      "additionalProperties": false,
      "properties": {
        "rows_validated": {
          "minimum": 0,
          "title": "Rows Validated",
          "type": "integer"
        },
        "rows_daily_panel": {
          "minimum": 0,
          "title": "Rows Daily Panel",
          "type": "integer"
        },
        "n_skus": {
          "minimum": 0,
          "title": "N Skus",
          "type": "integer"
        }
      },
      "required": [
        "rows_validated",
        "rows_daily_panel",
        "n_skus"
      ],
      "title": "ValidationSummary",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "pattern": "^1\\.[0-9]+\\.[0-9]+$",
      "title": "Schema Version",
      "type": "string"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "source": {
      "enum": [
        "dal",
        "fixture"
      ],
      "title": "Source",
      "type": "string"
    },
    "availability": {
      "$ref": "#/$defs/Availability"
    },
    "ingest_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Ingest Id",
      "type": "string"
    },
    "status": {
      "enum": [
        "accepted",
        "rejected",
        "failed",
        "needs_confirmation"
      ],
      "title": "Status",
      "type": "string"
    },
    "source_file": {
      "$ref": "#/$defs/SourceFile"
    },
    "deposit": {
      "anyOf": [
        {
          "$ref": "#/$defs/Deposit"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "header_diagnostic": {
      "anyOf": [
        {
          "$ref": "#/$defs/HeaderDiagnostic"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "validation": {
      "anyOf": [
        {
          "$ref": "#/$defs/ValidationSummary"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "published": {
      "anyOf": [
        {
          "$ref": "#/$defs/PublishedArtifact"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "quality_log": {
      "items": {
        "$ref": "#/$defs/QualityEntry"
      },
      "title": "Quality Log",
      "type": "array"
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/ErrorInfo"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "schema_version",
    "generated_at",
    "source",
    "availability",
    "ingest_id",
    "status",
    "source_file"
  ],
  "title": "IngestReport",
  "type": "object"
}
