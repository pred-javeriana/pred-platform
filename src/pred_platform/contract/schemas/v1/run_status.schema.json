{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pred-contrato/v1/run_status.schema.json",
  "x-contract-version": "1.3.0",
  "$defs": {
    "Availability": {
      "additionalProperties": false,
      "description": "Si el dato existe hoy. Sostiene estados vacios y acciones deshabilitadas.",
      "properties": {
        "status": {
          "enum": [
            "available",
            "unavailable"
          ],
          "title": "Status",
          "type": "string"
        },
        "reason_code": {
          "anyOf": [
            {
              "enum": [
                "no_data",
                "not_implemented",
                "stage_not_implemented",
                "prerequisite_missing"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason Code"
        },
        "blocked_by": {
          "items": {
            "pattern": "^G[1-8]$",
            "type": "string"
          },
          "title": "Blocked By",
          "type": "array"
        },
        "detail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detail"
        }
      },
      "required": [
        "status"
      ],
      "title": "Availability",
      "type": "object"
    },
    "DiscardCause": {
      "additionalProperties": false,
      "description": "Cuantos ensayos se descartaron por una causa del motor y un ejemplo.\n\n`cause` es un identificador abierto del motor (`ajuste_fallido`, `escalon`,\n`poda_semantica`, `configuracion_invalida`, `ninguna_ventana_convergio`,\n`sin_motivo_registrado`).",
      "properties": {
        "cause": {
          "minLength": 1,
          "title": "Cause",
          "type": "string"
        },
        "count": {
          "minimum": 1,
          "title": "Count",
          "type": "integer"
        },
        "example": {
          "anyOf": [
            {
              "$ref": "#/$defs/DiscardExample"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "cause",
        "count"
      ],
      "title": "DiscardCause",
      "type": "object"
    },
    "DiscardExample": {
      "additionalProperties": false,
      "description": "Un ensayo de la busqueda descartado por una causa, como ejemplo de esa causa.\n\n`window` es la ventana de validacion (desde 1) en que se descarto. Una poda por escalon\nlleva `rung`, el error del ensayo en `value` y el umbral de los `keep` mejores en\n`threshold`; una poda semantica, la regla en `rule` y el error en `value`; una\nconfiguracion invalida, la restriccion que no cumplio en `constraint`; un ajuste\nfallido, `fit`.",
      "properties": {
        "window": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Window"
        },
        "rung": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rung"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "threshold": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Threshold"
        },
        "keep": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Keep"
        },
        "rule": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rule"
        },
        "constraint": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Constraint"
        },
        "fit": {
          "anyOf": [
            {
              "$ref": "#/$defs/FitFacts"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "DiscardExample",
      "type": "object"
    },
    "Ejecucion": {
      "additionalProperties": false,
      "description": "Fila de `ejecuciones`.",
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "ingest_id": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ingest Id"
        },
        "configuracion_id": {
          "title": "Configuracion Id",
          "type": "string"
        },
        "seed": {
          "title": "Seed",
          "type": "integer"
        },
        "estado": {
          "enum": [
            "pendiente",
            "ejecutando",
            "completada",
            "completada_con_fallos",
            "detenida"
          ],
          "title": "Estado",
          "type": "string"
        },
        "iniciada_en": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Iniciada En"
        },
        "finalizada_en": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Finalizada En"
        }
      },
      "required": [
        "id",
        "configuracion_id",
        "seed",
        "estado"
      ],
      "title": "Ejecucion",
      "type": "object"
    },
    "ErrorFacts": {
      "additionalProperties": false,
      "description": "Datos estructurados de un error del motor (desde 1.3.0, seccion 11).\n\nRepiten en campos lo que `detail` cuenta en texto, para que la interfaz los muestre sin\nleer el mensaje. Cada grupo es opcional: el motor solo envia los que conoce.",
      "properties": {
        "search": {
          "anyOf": [
            {
              "$ref": "#/$defs/SearchFacts"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "fit": {
          "anyOf": [
            {
              "$ref": "#/$defs/FitFacts"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "history": {
          "anyOf": [
            {
              "$ref": "#/$defs/HistoryFacts"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "ErrorFacts",
      "type": "object"
    },
    "ErrorInfo": {
      "additionalProperties": false,
      "description": "Error normalizado. `code` es el que se persiste en `bitacora_calidad.codigo`.",
      "properties": {
        "code": {
          "anyOf": [
            {
              "enum": [
                "not_in_policy_matrix",
                "not_configured",
                "series_too_short",
                "execution_failed"
              ],
              "type": "string"
            },
            {
              "pattern": "^[a-z_]+\\.[a-z_]+$",
              "type": "string"
            }
          ],
          "title": "Code"
        },
        "stage": {
          "enum": [
            "L0",
            "L1",
            "L2",
            "L3",
            "L4",
            "platform"
          ],
          "title": "Stage",
          "type": "string"
        },
        "severity": {
          "default": "error",
          "enum": [
            "info",
            "advertencia",
            "error"
          ],
          "title": "Severity",
          "type": "string"
        },
        "detail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detail"
        },
        "field": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Field"
        },
        "row_index": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Row Index"
        },
        "column": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Column"
        },
        "source_exception": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Exception"
        },
        "retryable": {
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        },
        "facts": {
          "anyOf": [
            {
              "$ref": "#/$defs/ErrorFacts"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "code",
        "stage"
      ],
      "title": "ErrorInfo",
      "type": "object"
    },
    "FitFacts": {
      "additionalProperties": false,
      "description": "Por que un modelo no se ajusto o no pronostico (desde 1.3.0, seccion 11).\n\n`reason` es un identificador abierto del motor (`raiz_en_borde`, `sin_convergencia`,\n`error_biblioteca`, `pronostico_fallido`, `forma_cuantiles`, `cuantil_ausente`). `value`\ny `limit` son el valor medido y el limite que no cumplio, cuando la causa es numerica.",
      "properties": {
        "model": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "limit": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Limit"
        }
      },
      "required": [
        "reason"
      ],
      "title": "FitFacts",
      "type": "object"
    },
    "HistoryFacts": {
      "additionalProperties": false,
      "description": "Observaciones que exigia el modelo o la validacion y las que tenia la serie.",
      "properties": {
        "required": {
          "minimum": 1,
          "title": "Required",
          "type": "integer"
        },
        "available": {
          "minimum": 0,
          "title": "Available",
          "type": "integer"
        }
      },
      "required": [
        "required",
        "available"
      ],
      "title": "HistoryFacts",
      "type": "object"
    },
    "Page": {
      "additionalProperties": false,
      "properties": {
        "number": {
          "minimum": 1,
          "title": "Number",
          "type": "integer"
        },
        "size": {
          "maximum": 500,
          "minimum": 1,
          "title": "Size",
          "type": "integer"
        },
        "total": {
          "minimum": 0,
          "title": "Total",
          "type": "integer"
        }
      },
      "required": [
        "number",
        "size",
        "total"
      ],
      "title": "Page",
      "type": "object"
    },
    "Progress": {
      "additionalProperties": false,
      "properties": {
        "tareas_total": {
          "minimum": 0,
          "title": "Tareas Total",
          "type": "integer"
        },
        "tareas_por_estado": {
          "additionalProperties": {
            "type": "integer"
          },
          "propertyNames": {
            "enum": [
              "pendiente",
              "ejecutando",
              "finalizo_m2",
              "exitosa",
              "fallida",
              "no_ejecutable"
            ]
          },
          "title": "Tareas Por Estado",
          "type": "object"
        },
        "avance_pct": {
          "maximum": 100,
          "minimum": 0,
          "title": "Avance Pct",
          "type": "number"
        },
        "etapa_actual": {
          "anyOf": [
            {
              "enum": [
                "L1",
                "L2",
                "L3",
                "L4"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Etapa Actual"
        },
        "skus_total": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Skus Total"
        },
        "skus_terminados": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Skus Terminados"
        }
      },
      "required": [
        "tareas_total",
        "tareas_por_estado",
        "avance_pct"
      ],
      "title": "Progress",
      "type": "object"
    },
    "Reserve": {
      "additionalProperties": false,
      "description": "Reserva cronologica para M3 (ADR-03-003 del motor): el 20 % final del calendario.",
      "properties": {
        "fraction": {
          "exclusiveMaximum": 1,
          "exclusiveMinimum": 0,
          "title": "Fraction",
          "type": "number"
        },
        "t_star": {
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "title": "T Star",
          "type": "string"
        },
        "first_reserved": {
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "title": "First Reserved",
          "type": "string"
        },
        "last_observed": {
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "title": "Last Observed",
          "type": "string"
        },
        "reserved_days": {
          "minimum": 1,
          "title": "Reserved Days",
          "type": "integer"
        }
      },
      "required": [
        "fraction",
        "t_star",
        "first_reserved",
        "last_observed",
        "reserved_days"
      ],
      "title": "Reserve",
      "type": "object"
    },
    "RunSettings": {
      "additionalProperties": false,
      "description": "Contenido de `configuraciones.parametros` (JSON) que la interfaz necesita mostrar.",
      "properties": {
        "schema_version": {
          "minimum": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "configuracion_version": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Configuracion Version"
        },
        "families": {
          "anyOf": [
            {
              "items": {
                "enum": [
                  "classical",
                  "ml",
                  "dl",
                  "foundation"
                ],
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Families"
        },
        "policy_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Policy Version"
        },
        "min_train": {
          "minimum": 1,
          "title": "Min Train",
          "type": "integer"
        },
        "horizon": {
          "minimum": 1,
          "title": "Horizon",
          "type": "integer"
        },
        "step": {
          "minimum": 1,
          "title": "Step",
          "type": "integer"
        },
        "metric": {
          "enum": [
            "mae",
            "rmse",
            "smape",
            "mase"
          ],
          "title": "Metric",
          "type": "string"
        },
        "seasonality": {
          "minimum": 1,
          "title": "Seasonality",
          "type": "integer"
        },
        "aggregation": {
          "anyOf": [
            {
              "enum": [
                "media",
                "mediana",
                "media_recortada"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Aggregation"
        },
        "trim": {
          "anyOf": [
            {
              "exclusiveMaximum": 0.5,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Trim"
        }
      },
      "required": [
        "schema_version",
        "min_train",
        "horizon",
        "step",
        "metric",
        "seasonality",
        "aggregation",
        "trim"
      ],
      "title": "RunSettings",
      "type": "object"
    },
    "SearchFacts": {
      "additionalProperties": false,
      "description": "Resumen de una busqueda de configuraciones que no dejo ningun ensayo completo.",
      "properties": {
        "failed": {
          "minimum": 0,
          "title": "Failed",
          "type": "integer"
        },
        "pruned": {
          "minimum": 0,
          "title": "Pruned",
          "type": "integer"
        },
        "invalid_attempts": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Invalid Attempts"
        },
        "causes": {
          "items": {
            "$ref": "#/$defs/DiscardCause"
          },
          "title": "Causes",
          "type": "array"
        }
      },
      "required": [
        "failed",
        "pruned"
      ],
      "title": "SearchFacts",
      "type": "object"
    },
    "Tarea": {
      "additionalProperties": false,
      "description": "Fila de `tareas`: una por unidad del motor, es decir, por SKU x modelo (decision D6).\n\nEl estado resume las etapas L2 a L4 de esa unidad: `finalizo_m2` cuando termino L2 y L3,\n`exitosa` cuando M3 (L4) guardo su candidato. La traza por etapa queda en el motor.",
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "sku": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sku"
        },
        "modelo": {
          "pattern": "^(classical|ml|dl|foundation):[a-z0-9][a-z0-9._-]*$",
          "title": "Modelo",
          "type": "string"
        },
        "family": {
          "anyOf": [
            {
              "enum": [
                "classical",
                "ml",
                "dl",
                "foundation"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Family"
        },
        "corte": {
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "title": "Corte",
          "type": "string"
        },
        "estado": {
          "enum": [
            "pendiente",
            "ejecutando",
            "finalizo_m2",
            "exitosa",
            "fallida",
            "no_ejecutable"
          ],
          "title": "Estado",
          "type": "string"
        },
        "seed": {
          "title": "Seed",
          "type": "integer"
        },
        "tiempo_pared_s": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tiempo Pared S"
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/ErrorInfo"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "iniciada_en": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Iniciada En"
        },
        "finalizada_en": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Finalizada En"
        }
      },
      "required": [
        "id",
        "modelo",
        "corte",
        "estado",
        "seed"
      ],
      "title": "Tarea",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "pattern": "^1\\.[0-9]+\\.[0-9]+$",
      "title": "Schema Version",
      "type": "string"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "source": {
      "enum": [
        "dal",
        "fixture"
      ],
      "title": "Source",
      "type": "string"
    },
    "availability": {
      "$ref": "#/$defs/Availability"
    },
    "ejecucion": {
      "anyOf": [
        {
          "$ref": "#/$defs/Ejecucion"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "settings": {
      "anyOf": [
        {
          "$ref": "#/$defs/RunSettings"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "reserve": {
      "anyOf": [
        {
          "$ref": "#/$defs/Reserve"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "progress": {
      "anyOf": [
        {
          "$ref": "#/$defs/Progress"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "tasks": {
      "items": {
        "$ref": "#/$defs/Tarea"
      },
      "title": "Tasks",
      "type": "array"
    },
    "page": {
      "anyOf": [
        {
